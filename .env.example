# Public browser configuration (safe to expose in a Vite bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_ADMIN_EMAIL=admin@example.invalid

# GitHub Actions only. Never expose these as VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_GITHUB_ACTIONS_ONLY

# Supabase Edge Function secrets
DISPATCH_SHARED_SECRET=GENERATE_A_RANDOM_VALUE
GITHUB_APP_ID=YOUR_APP_ID
GITHUB_APP_INSTALLATION_ID=YOUR_INSTALLATION_ID
GITHUB_APP_PRIVATE_KEY=YOUR_PEM_PRIVATE_KEY
GITHUB_REPOSITORY_OWNER=YOUR_GITHUB_OWNER
GITHUB_REPOSITORY_NAME=weekly-price-cs
